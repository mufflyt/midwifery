cff-version: 1.2.0
message: "If you use this dataset or software in academic research or clinical policy analysis, please cite it as below."
type: software
authors:
  # Authorship order is deliberate and agreed: Muffly first, Thumm second.
  # ORCIDs are marked TODO rather than guessed. The value previously recorded
  # here for Muffly, 0000-0002-1825-0097, was copied from the example in a
  # comment and is the ORCID demonstration identifier, not his.
  - family-names: "Muffly"
    given-names: "Tyler"
    email: "tyler.muffly@dhha.org"
    affiliation: "Department of Obstetrics and Gynecology, Denver Health and Hospital Authority, Denver, Colorado, USA"
    # TODO: orcid: "https://orcid.org/XXXX-XXXX-XXXX-XXXX"
  - family-names: "Thumm"
    given-names: "Elisabeth B."
    affiliation: "Denver Health and Hospital Authority, Denver, Colorado, USA"
    # TODO: orcid: "https://orcid.org/XXXX-XXXX-XXXX-XXXX"
title: "National Certified Nurse-Midwife (CNM) 50-State & DC Workforce & Board of Nursing Registry Dataset"
version: "4.0.0"
doi: "10.5281/zenodo.1054200"
date-released: 2026-08-14
license: MIT
url: "https://github.com/mufflyt/midwifery"
repository-code: "https://github.com/mufflyt/midwifery"
keywords:
  - "certified nurse-midwives"
  - "midwifery workforce"
  - "board of nursing"
  - "maternity care deserts"
  - "nppes"
  - "amcb"
  - "health services research"
references:
  # The data sources the pipeline consumes. These are cited here so that a
  # citation manager pulling CITATION.cff also picks up what the estimates
  # actually rest on -- the code is not the evidence, these are.
  - type: database
    title: "AMCB Instant Verification: public primary-source verification of certified midwives"
    authors:
      - name: "American Midwifery Certification Board"
    url: "https://ams.amcbmidwife.org/amcbssa/f?p=AMCBSSA:17800"
    year: 2026
    notes: "Accessed 2026-08-06. 22,309 certificants. Names, certification numbers, status and dates are public; no location is published at any level."
  - type: database
    title: "NPPES: National Plan and Provider Enumeration System, NPI downloadable files"
    authors:
      - name: "Centers for Medicare & Medicaid Services"
    url: "https://download.cms.gov/nppes/NPI_Files.html"
    year: 2026
    notes: "Monthly snapshots 2007-2025 plus the August 2026 full file; supplies candidate NPIs, taxonomy and practice address."
  - type: database
    title: "Doctors and Clinicians national downloadable file"
    authors:
      - name: "Centers for Medicare & Medicaid Services"
    url: "https://data.cms.gov/provider-data/topics/doctors-clinicians"
    year: 2026
    notes: "June 2026 release. Practice-address corroboration, group affiliation, medical school and graduation year."
  - type: database
    title: "Provider of Services file: hospital and non-hospital facilities"
    authors:
      - name: "Centers for Medicare & Medicaid Services"
    url: "https://data.cms.gov/provider-characteristics/hospitals-and-other-facilities/provider-of-services-file-hospital-non-hospital-facilities"
    year: 2026
    notes: "Obstetric service flag OB_SRVC_CD, used for county-level obstetric hospital counts."
  - type: database
    title: "Open Payments (Physician Payments Sunshine Act) general and research payments"
    authors:
      - name: "Centers for Medicare & Medicaid Services"
    url: "https://openpaymentsdata.cms.gov/"
    year: 2026
    notes: "Used for address recency and Type 2 organization resolution, not for any payment-behaviour claim."
  - type: database
    title: "Area Health Resources Files, 2024-2025 release"
    authors:
      - name: "U.S. Health Resources and Services Administration"
    url: "https://data.hrsa.gov/data/download"
    year: 2025
    notes: "County midwife and OB/GYN counts, births, birth outcomes, birthing rooms."
  - type: database
    title: "American Community Survey 5-year estimates, 2019-2023"
    authors:
      - name: "U.S. Census Bureau"
    url: "https://api.census.gov/data/2023/acs/acs5"
    year: 2024
    notes: "Population, women aged 15-50, births in the past 12 months, median household income. Requires a free API key."
  - type: database
    title: "Cartographic Boundary Files: counties, tracts and congressional districts"
    authors:
      - name: "U.S. Census Bureau"
    url: "https://www.census.gov/geographies/mapping-files/time-series/geo/cartographic-boundary.html"
    year: 2024
    notes: "TIGER-derived polygons used for point-in-polygon assignment; CD118 and CD119 (cb_2024_us_cd119_500k for current-Congress counts)."
  - type: database
    title: "Rural-Urban Continuum Codes, 2023 revision"
    authors:
      - name: "U.S. Department of Agriculture, Economic Research Service"
    url: "https://www.ers.usda.gov/data-products/rural-urban-continuum-codes"
    year: 2023
    notes: "Metro / nonmetro-adjacent / nonmetro-remote strata, collapsed from RUCC 1-3, 4-6, 7-9."
  - type: database
    title: "CDC WONDER Natality, county-level births by attendant"
    authors:
      - name: "U.S. Centers for Disease Control and Prevention, National Center for Health Statistics"
    url: "https://wonder.cdc.gov/natality.html"
    year: 2026
    notes: "CNM-attended births by county. Suppressed cells are carried as suppressed, never as zero."
  - type: database
    title: "County Health Rankings & Roadmaps, 2025 release"
    authors:
      - name: "University of Wisconsin Population Health Institute"
    url: "https://www.countyhealthrankings.org/health-data"
    year: 2025
    notes: "Low birth weight, infant mortality, uninsured share."
  - type: database
    title: "Accredited midwifery education programs"
    authors:
      - name: "Accreditation Commission for Midwifery Education"
    url: "https://theacme.org/accredited-midwifery-education-programs/"
    year: 2026
    notes: "The 50-program sampling frame behind the institutional-repository harvest for training institution."
